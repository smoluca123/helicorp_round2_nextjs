model UserGuest {
  id                    String    @id @default(cuid())
  email                 String    @unique
  securityCode          String?
  securityCodeExpiresAt DateTime?
  isVerified            Boolean   @default(false)

  cartItems               CartItem[]
  wishlistItems           WishlistItem[]
  newsletterSubscriptions NewsletterSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_guests")
}

model NewsletterSubscription {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userGuestId String
  userGuest   UserGuest @relation(fields: [userGuestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Mỗi người dùng chỉ đăng ký nhận tin 1 lần cho 1 sản phẩm
  @@unique([userGuestId, productId])
  @@map("newsletter_subscriptions")
}

model CartItem {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userGuestId String
  userGuest   UserGuest @relation(fields: [userGuestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userGuestId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userGuestId String
  userGuest   UserGuest @relation(fields: [userGuestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userGuestId, productId])
  @@map("wishlist_items")
}
