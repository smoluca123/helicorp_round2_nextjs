model Media {
  id      String  @id @default(cuid())
  url     String // Đường dẫn ảnh/video
  type    String  @default("IMAGE") // IMAGE, VIDEO
  altText String?

  // Quan hệ ngược
  products Product[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medias")
}
